# Copy this file to the ignored keystore.properties file, then set strong local values.
# Keep the keystore outside this repository and back it up securely: Android requires the
# same signing key for all future FrostKeys updates. If FROSTKEYS_STORE_FILE is omitted, Gradle
# uses %USERPROFILE%\\.android\\frostkeys-personal.jks on Windows (or ~/.android on other hosts).
# FROSTKEYS_STORE_FILE=C:/Users/your-user/.android/frostkeys-personal.jks
FROSTKEYS_STORE_PASSWORD=
# FROSTKEYS_KEY_ALIAS=frostkeys-personal
FROSTKEYS_KEY_PASSWORD=
# Required release guard: the SHA-256 fingerprint of the certificate under the alias above,
# with or without colons. Record it once when the long-lived keystore is created.
FROSTKEYS_CERT_SHA256=
