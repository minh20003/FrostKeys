<helium314.keyboard.latin.RoundedKeyboardFrameView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_keyboard_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false" >

    <HorizontalScrollView
        android:id="@+id/persistent_emoji_row_scroll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scrollbars="none"
        android:visibility="gone"
        android:background="@android:color/transparent" >
        <LinearLayout
            android:id="@+id/persistent_emoji_row_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:id="@+id/persistent_emoji_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15808080"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/strip_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/config_suggestions_strip_height"
        android:clipChildren="false"
        android:clipToPadding="false">
        <!-- Keep this LTR so key previews stay aligned while the device uses an RTL locale. -->
        <helium314.keyboard.latin.suggestions.SuggestionStripView
            android:id="@+id/suggestion_strip_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            style="?attr/suggestionStripViewStyle" />

        <LinearLayout
            android:id="@+id/emoji_tab_strip_container"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            style="?attr/suggestionStripViewStyle">
            <ImageButton
                android:id="@+id/emoji_back_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/content_description_back"
                android:background="?android:attr/selectableItemBackground" />
            <LinearLayout
                android:id="@+id/emoji_tab_strip"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/clipboard_strip_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarThumbHorizontal="@color/toolbar_scrollbar"
            style="?attr/suggestionStripViewStyle">
            <LinearLayout
                android:id="@+id/clipboard_strip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:clipChildren="false"
        android:clipToPadding="false" >

        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <!-- Emoji resources and its RecyclerView are only needed after the panel is opened. -->
        <ViewStub
            android:id="@+id/emoji_palettes_stub"
            android:inflatedId="@+id/emoji_palettes_view"
            android:layout="@layout/emoji_palettes_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <!-- The clipboard list and adapter are similarly deferred until the user opens it. -->
        <ViewStub
            android:id="@+id/clipboard_history_stub"
            android:inflatedId="@+id/clipboard_history_view"
            android:layout="@layout/clipboard_history_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <!-- Heavy media/Compose panel: inflate only after the user explicitly opens GIFs or stickers. -->
        <ViewStub
            android:id="@+id/klipy_palettes_stub"
            android:inflatedId="@+id/klipy_palettes_view"
            android:layout="@layout/klipy_palettes_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <helium314.keyboard.keyboard.AccessPointMenuView
            android:id="@+id/access_point_menu_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <!-- The AI panel inflates a ViewPager and Compose controls, so defer it until first use. -->
        <ViewStub
            android:id="@+id/ai_writing_tools_stub"
            android:inflatedId="@+id/ai_writing_tools_view"
            android:layout="@layout/lazy_ai_writing_tools_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <!-- Translation panel: inflate only after the user explicitly opens translation. -->
        <ViewStub
            android:id="@+id/translation_stub"
            android:inflatedId="@+id/translation_view"
            android:layout="@layout/lazy_translation_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

    </helium314.keyboard.latin.KeyboardWrapperView>

</helium314.keyboard.latin.RoundedKeyboardFrameView>
