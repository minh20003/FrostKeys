<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated offline Rime Pinyin conversion row; never interpreted as Latin SuggestedWords. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rime_candidate_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/rime_mode_button"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/rime_mode_simplified"
        android:gravity="center"
        android:minWidth="48dp"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <ImageButton
        android:id="@+id/rime_candidate_previous"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/rime_candidate_previous_page"
        android:minWidth="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_left" />

    <HorizontalScrollView
        android:id="@+id/rime_candidate_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rime_candidate_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ImageButton
        android:id="@+id/rime_candidate_next"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/rime_candidate_next_page"
        android:minWidth="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_right" />

    <ImageButton
        android:id="@+id/rime_candidate_cancel"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/rime_cancel_composition"
        android:minWidth="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_close" />
</LinearLayout>
