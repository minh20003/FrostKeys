<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated Mozc conversion strip. This is intentionally separate from the generic prediction
  layouts: candidate clicks must return the runtime generation and native candidate id rather
  than be interpreted as Latin SuggestedWords.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mozc_candidate_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/mozc_mode_button"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/mozc_mode_hiragana"
        android:gravity="center"
        android:minWidth="48dp"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <ImageButton
        android:id="@+id/mozc_candidate_previous"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/mozc_candidate_previous_page"
        android:minWidth="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_left" />

    <HorizontalScrollView
        android:id="@+id/mozc_candidate_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mozc_candidate_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ImageButton
        android:id="@+id/mozc_candidate_next"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/mozc_candidate_next_page"
        android:minWidth="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_right" />

    <ImageButton
        android:id="@+id/mozc_candidate_cancel"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/mozc_cancel_composition"
        android:minWidth="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_close" />

</LinearLayout>
