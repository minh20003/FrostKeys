#
# Append this file and copy frostkeys_mozc_jni.cc into
# <temporary Mozc snapshot>/src/android/jni/ before invoking Bazel.  It is an
# append fragment, not a standalone BUILD file: the upstream package already
# loads MOZC_TAGS, mozc_cc_binary, cross_build_binary and owns the Android
# platform labels.  Keeping the target in //android/jni is necessary because
# the pinned upstream dependencies deliberately grant that package narrowly
# scoped visibility.  This target intentionally does not depend on :mozcjni,
# so it never registers the upstream com.google Android class or its global
# session handler.

mozc_cc_binary(
    name = "frostkeys_mozc",
    srcs = ["frostkeys_mozc_jni.cc"],
    linkopts = [
        "-llog",
        # Android 15-class ARM64 devices require flexible page alignment.
        "-Wl,-z,max-page-size=16384",
    ],
    linkshared = 1,
    tags = MOZC_TAGS.ANDROID_ONLY,
    target_compatible_with = _TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
    deps = [
        "//base:system_util",
        "//data_manager",
        "//engine",
        "//protocol:commands_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/status:statusor",
    ],
)

cross_build_binary(
    name = "frostkeys_mozc.arm64",
    cpu = "arm64-v8a",
    platform = ":arm64-v8a",
    tags = MOZC_TAGS.ANDROID_ONLY,
    target = ":frostkeys_mozc",
)
